{
    "lw_harness": {
        "user_id": "claude-sonnet-4.5_agentic",
        "harness_name": "lw_agentic",

        "data_root": "data/edit_192_external",
        "difficulty": null,
        "image_dirs": [],

        "parquet": "data/edit_192_external/parquets/val_edit_text.parquet",
        "output_dir": "lw_solution_v2/outputs",
        "work_dir": null,

        "workers": 4,

        "output_image_size": 1024,
        "output_image_ext": "png",
        "save_transcripts": true,

        "agent": {
            "max_steps": 14,
            "max_builds": 6,

            "bootstrap_brep_json": true,
            "bootstrap_views": ["iso_top_right", "iso_bottom_left"],
            "bootstrap_draw_bbox": true,
            "bootstrap_label_faces": true,
            "brep_json_max_chars": 6000,
            "views_resolution": 900,
            "views_draw_edges": false,
            "input_views": [],

            "build_views": ["toprightiso"],
            "final_check_views": ["toprightiso", "front", "top"],
            "render_size": 800,
            "keep_image_turns": 2,
            "build_timeout": 180,
            "analyze_timeout": 120,
            "fallback_to_input": true,
            "stdout_limit": 2500
        }
    },

    "annotations_dir": {
        "type": "local",
        "paths": []
    },
    "models_dir": {
        "type": "local",
        "paths": [
            "lw_solution_v2/outputs"
        ]
    },
    "storage_dir": {
        "type": "local",
        "path": "data/edit_192_external"
    },
    "db_name": "v2_db",
    "dino_model": "facebook/dinov2-base",
    "dino_device": "cpu",
    "dino_batch_size": 16,

    "benchmark_eval_users": {
        "edit": [
            "gt human",
            "other human",
            "gemini-3-pro_cadquery-script",
            "gpt-5.2_cadquery-script",
            "claude-sonnet-4.5_cadquery-script",
            "gpt-5.6-sol_openrouter_cadquery-script",
            "claude-sonnet-4.5_agentic",
            "gpt-5.2_agentic",
            "gemini-3-pro_agentic"
        ]
    },

    "benchmark_models": {
        "claude-sonnet-4.5_agentic": {
            "family": "anthropic",
            "model": "claude-sonnet-4-5",
            "thinking": {
                "type": "enabled",
                "budget_tokens": 4000
            },
            "max_tokens": 16000,
            "1m_token_cost_input": 3.00,
            "1m_token_cost_output": 15.00
        },
        "gpt-5.2_agentic": {
            "family": "openai",
            "model": "gpt-5.2-2025-12-11",
            "reasoning_level": "medium",
            "1m_token_cost_input": 1.75,
            "1m_token_cost_output": 14.00
        },
        "gemini-3-pro_agentic": {
            "family": "gemini",
            "model": "gemini-3-pro-preview",
            "thinking_level": "high",
            "1m_token_cost_input": 2.00,
            "1m_token_cost_output": 12.00
        }
    }
}
